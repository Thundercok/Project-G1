  m_Name: 
  m_EditorClassIdentifier: 
  npcName: MEDIC SORENSEN
  role: 1
  district: "AID POST \u2014 PLAZA EAST"
  questId: medical-cache
  questTitle: Recover the medical cache from the breach ruins
  mandatory: 0
  requiredCount: 1
  hasQuestTarget: 1
  questTarget: {x: 4, y: 0, z: -168}
  targetLabel: MEDICAL CACHE
  offerLine: I'm out of everything. Our resupply is sitting in the southern ruins
    with about thirty Taken walking circles around it. Get to the cache and I can
    keep people breathing.
  acceptLine: Straight south into the ruins. Don't stop moving in there.
  nagLine: "No cache, no patients \u2014 that's the arithmetic. Please hurry."
  turnInLine: "That's blood and bandages for a week. Patched you up too. Riggs is
    holding the motor pool \u2014 he pays better than I do."
  doneLine: Stay whole. I'd rather not see you on this table.
  rewardHealth: 60
  rewardArmor: 25
  rewardAmmo: 1
  rewardWeaponIndex: -1
  introducesContact: QUARTERMASTER RIGGS
  autoDiscoverRange: 22
  talkRange: 3.2
  activateOnAccept: []
  openOnAccept: []
  alarmOnAccept: 0
