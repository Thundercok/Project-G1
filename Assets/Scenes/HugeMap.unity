  m_IsActive: 1
--- !u!114 &678993955
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 678993954}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 940959b443ce14c4981b87149483ae3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  chapters:
  - objectiveId: first-contact
    title: PROLOGUE
    subtitle: THE GATE
    onOpen:
    - who: 0
      line: 'Hazard suit online. Local iteration index: unavailable. You are at the
        south gate of the Corvus Sprawl. There are people alive past this wall and
        no clean way to reach them.'
    onClose:
    - who: 1
      line: You found one of ours. Good. You always find one of ours.
  - objectiveId: echo-witness
    title: CHAPTER ONE
    subtitle: WHAT IS LEFT OF FORTY-ONE
    onOpen:
    - who: 2
      line: It said it used to be me. Forty loops ago, it was me, and it is still
        standing at the place where it stopped.
    onClose:
    - who: 1
      line: Forty-one was an excellent Anchor. Not as good as you. Nobody has ever
        been as good as you.
  - objectiveId: medical-cache
    title: CHAPTER TWO
    subtitle: THE LIVING
    onOpen:
    - who: 0
      line: 'Medical stores located in the southern ruins. Casualty count inside
        the Sprawl: rising.'
    onClose:
    - who: 2
      line: Sorensen doesn't know this has all happened before. I am not going to
        be the one who tells her.
  - objectiveId: gunship
    title: CHAPTER THREE
    subtitle: WHAT IS IN THE SKY
    onOpen:
    - who: 0
      line: Rotor signature holding over the central plaza. Hostile. Four strafing
        runs on the motor pool in the last hour.
    onClose:
    - who: 1
      line: You brought down a gunship that has been brought down two hundred and
        five times already. It flies again on Tuesday. It always flies again on Tuesday.
  - objectiveId: hold-plaza
    title: CHAPTER FOUR
    subtitle: GROUND
    onOpen:
    - who: 2
      line: Vance's line has been stuck sixty metres short of the plaza for two days.
        Two days, in a place where the days repeat.
    onClose:
    - who: 1
      line: Ground taken. Ground is not the thing you are running out of.
  - objectiveId: restore-comms
    title: CHAPTER FIVE
    subtitle: DEAD AIR
    onOpen:
    - who: 0
      line: All external communications severed. The southeast dish is structurally
        intact and unpowered.
    onClose:
    - who: 1
      line: You put the Sprawl back on the air. Thank you, sincerely. It makes the
        reporting so much easier.
  - objectiveId: recover-core
    title: CHAPTER SIX
    subtitle: TWO HUNDRED AND SIX
    onOpen:
    - who: 2
      line: Halloran wants the iteration count off the data core. I already know
        I am not going to like the number.
    onClose:
    - who: 1
      line: Two hundred and six. Say it again. It is a good number. A great deal
        of work went into reaching it.
  - objectiveId: tower-relay
    title: CHAPTER SEVEN
    subtitle: WHAT HE IS SAYING
    onOpen:
    - who: 0
      line: Carrier signal originating from the command tower. Outbound. Encrypted.
        Continuous for seventy-one hours.
    onClose:
    - who: 1
      line: You have heard it now, so I will not insult you. Yes, I file. Yes, something
        reads what I file. No, it is not coming to help you. It is coming to collect.
  - objectiveId: emitters
    title: FINALE
    subtitle: THE THRESHOLD
    onOpen:
    - who: 1
      line: There is a ring in the southern ruins that has been humming since before
        you were assigned here. Step through it and you wake up in the locker room
        with clean hands and no memory of me. That is the offer. It has always been
        the offer.
    - who: 0
      line: 'Three resonance emitters detected at the ring. Structural integrity:
        destructible.'
    - who: 2
      line: He keeps calling it an offer. He has never once called it a way out.
    onClose:
    - who: 2
      line: Two hundred and six people stood here and stepped through. I am the two
        hundred and seventh, and I brought a crowbar.
    - who: 1
      line: ...Ah. Well. That is inconvenient.
  lineHold: 5.5
  betweenLines: 0.6
