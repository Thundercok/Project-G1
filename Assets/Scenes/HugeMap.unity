  m_Name: 
  m_EditorClassIdentifier: 
  npcName: DR. HALLORAN
  role: 3
  district: "LIVING QUARTERS \u2014 NORTHWEST"
  questId: recover-core
  questTitle: Recover the data core from the northeast warehouse
  mandatory: 0
  requiredCount: 1
  hasQuestTarget: 1
  questTarget: {x: 148, y: 0, z: 146}
  targetLabel: DATA CORE
  offerLine: "Everything we recorded about the Threshold is on one core in the northeast
    warehouse \u2014 including the iteration count. I need to know what number we're
    on. Bring it to me."
  acceptLine: "Northeast warehouse. And doctor \u2014 read nothing on the way back."
  nagLine: Without that core we're guessing, and I'm tired of guessing.
  turnInLine: Iteration two hundred and six. Two hundred and six. ...Park is out
    on the east ridge. Tell him I said run.
  doneLine: Two hundred and six. I keep saying it. It doesn't help.
  rewardHealth: 30
  rewardArmor: 40
  rewardAmmo: 1
  rewardWeaponIndex: -1
  introducesContact: SIGNALS TECH PARK
  autoDiscoverRange: 22
  talkRange: 3.2
