  m_Script: {fileID: 11500000, guid: 0e955d16e69344063ac10a0d5a4bbdec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: ITERATION 41
  role: 6
  district: "SOUTH GATE \u2014 BREACH EDGE"
  questId: echo-witness
  questTitle: Stand where Iteration 41 fell
  mandatory: 0
  requiredCount: 1
  hasQuestTarget: 1
  questTarget: {x: -96, y: 0, z: -244}
  targetLabel: THE FALL SITE
  offerLine: You're the Anchor. I was too, forty loops ago... I still can't leave
    the spot where it took me. Go and stand there. Someone should see it who isn't
    already dead.
  acceptLine: West of the ruins. You'll know it. It's colder there.
  nagLine: You haven't gone yet. It's still waiting. It's always waiting.
  turnInLine: "You saw. Then some part of it is finally over. Sorensen's aid post
    is east of the plaza \u2014 the living need you more."
  doneLine: Go on. I'm not going anywhere. That's rather the problem.
  rewardHealth: 0
  rewardArmor: 40
  rewardAmmo: 0
  rewardWeaponIndex: -1
  introducesContact: MEDIC SORENSEN
  autoDiscoverRange: 22
  talkRange: 3.2
  activateOnAccept: []
  openOnAccept: []
  alarmOnAccept: 0
