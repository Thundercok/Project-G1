  m_Name: 
  m_EditorClassIdentifier: 
  npcName: CHIEF VANCE
  role: 2
  district: "ALLIED BASE \u2014 WEST"
  questId: hold-plaza
  questTitle: Push through to the central plaza
  mandatory: 0
  requiredCount: 1
  hasQuestTarget: 1
  questTarget: {x: 0, y: 0, z: 6}
  targetLabel: CENTRAL PLAZA
  offerLine: My line has been stuck sixty metres short of the plaza for two days.
    I don't need a hero, I need someone the Sweepers have to look at. Reach the plaza
    and my people follow you in.
  acceptLine: Then go. We move when you move.
  nagLine: The plaza's still theirs. Nothing's changed while you stood here.
  turnInLine: "The line's moving. First ground we've taken all week. Okafor's up
    at the labs \u2014 his comms problem is yours now."
  doneLine: You've got a squad behind you now. Use them.
  rewardHealth: 30
  rewardArmor: 40
  rewardAmmo: 1
  rewardWeaponIndex: -1
  introducesContact: ENGINEER OKAFOR
  autoDiscoverRange: 22
  talkRange: 3.2
