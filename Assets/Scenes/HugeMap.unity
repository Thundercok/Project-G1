  m_Name: 
  m_EditorClassIdentifier: 
  npcName: QUARTERMASTER RIGGS
  role: 5
  district: "MOTOR POOL \u2014 SOUTH PLAZA"
  questId: gunship
  questTitle: Destroy the HECU gunship
  mandatory: 0
  requiredCount: 1
  hasQuestTarget: 1
  questTarget: {x: 0, y: 14, z: 0}
  targetLabel: GUNSHIP
  offerLine: That gunship has strafed my yard four times. Every crate I move, it
    burns. Put it in the dirt and I'll open the good lockers for you.
  acceptLine: "Aim for the rotor. It flies over the plaza \u2014 you can't miss it."
  nagLine: I can still hear rotors. That means you're not finished.
  turnInLine: "Beautiful. Take everything you can carry. Chief Vance runs the base
    out west \u2014 she's been asking for a spare gun."
  doneLine: Lockers are open. Help yourself, quietly.
  rewardHealth: 25
  rewardArmor: 50
  rewardAmmo: 1
  rewardWeaponIndex: -1
  introducesContact: CHIEF VANCE
  autoDiscoverRange: 22
  talkRange: 3.2
  activateOnAccept: []
  openOnAccept: []
  alarmOnAccept: 0
