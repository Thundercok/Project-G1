  m_Name: 
  m_EditorClassIdentifier: 
  npcName: SIGNALS TECH PARK
  role: 4
  district: "EAST RIDGE \u2014 RELAY POST"
  questId: tower-relay
  questTitle: Plant the relay at the command tower
  mandatory: 0
  requiredCount: 1
  hasQuestTarget: 1
  questTarget: {x: 0, y: 0, z: 26}
  targetLabel: COMMAND TOWER
  offerLine: There's a man in a suit standing on top of the command tower and he
    has not moved in three days. I want a relay at the base of that tower so we can
    hear what he's transmitting. Do it and get clear.
  acceptLine: Base of the tower, dead centre of the plaza. Don't look up.
  nagLine: No relay, no idea what he's saying. Or to whom.
  turnInLine: "It's a carrier signal. Outbound. He's reporting on you \u2014 and
    something out there is answering. Get to extraction."
  doneLine: Whatever's listening already knows your name. Go.
  rewardHealth: 40
  rewardArmor: 60
  rewardAmmo: 1
  rewardWeaponIndex: -1
  introducesContact: 
  autoDiscoverRange: 22
  talkRange: 3.2
