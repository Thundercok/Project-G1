MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2050673177}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e955d16e69344063ac10a0d5a4bbdec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: SGT. KANE
  role: 2
  district: "SOUTH GATE \u2014 STAGING"
  questId: first-contact
  questTitle: Find a survivor inside the Sprawl
  mandatory: 0
  requiredCount: 1
  hasQuestTarget: 1
  questTarget: {x: -26, y: 0, z: -286}
  targetLabel: SURVIVOR SIGNAL
  offerLine: "Stop right there. Nobody walks into the Sprawl blind. We have people
    alive past this gate and no way to reach them \u2014 the yard beyond is HECU
    ground. Say the word and I open it, but the second it moves they will know you're
    coming. Find one of ours and get them talking."
  acceptLine: "Opening the gate. Take the crate first, then hit Q \u2014 the suit
    reads bio-signals and you'll want to know who's breathing before you round a
    corner. My two are with you. Move!"
  nagLine: Gate's open and the yard's hot. Go find our people.
  turnInLine: "You found one. That's more than we managed in two days. Take the resupply
    \u2014 and whatever that thing out there told you, keep walking."
  doneLine: Gate stays open. Bring them home if you can.
  rewardHealth: 40
  rewardArmor: 50
  rewardAmmo: 1
  rewardWeaponIndex: -1
  introducesContact: ITERATION 41
  autoDiscoverRange: 22
  talkRange: 3.2
  activateOnAccept:
  - {fileID: 1897760776}
  openOnAccept:
  - {fileID: 1525040394}
  alarmOnAccept: 1
